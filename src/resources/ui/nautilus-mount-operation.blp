using Gtk 4.0;
using Adw 1;
// Credentials prompt of NautilusMountOperation. Every row the backends can
// ask for is declared here; the code shows the ones each request needs.
Adw.AlertDialog dialog {
  default-response: "connect";
  close-response: "cancel";
  // Stays open after Connect to show progress. See on_close_attempt().
  can-close: false;
  response => $on_dialog_response();
  close-attempt => $on_close_attempt();

  extra-child: Box {
    orientation: vertical;
    spacing: 12;

    Box content {
      orientation: vertical;
      spacing: 12;

      Revealer error_revealer {
        child: Label error_label {
          wrap: true;
          justify: center;

          styles [
            "error",
          ]
        };
      }

      Adw.PreferencesGroup anonymous_group {
        visible: false;

        Adw.SwitchRow anonymous_row {
          title: _("Connect _Anonymously");
          use-underline: true;
          notify::active => $on_anonymous_changed();
        }
      }

      Adw.PreferencesGroup credentials_group {
        Adw.EntryRow username_row {
          title: _("_Username");
          use-underline: true;
          visible: false;
          changed => $on_input_changed();
          entry-activated => $on_entry_activated();
        }

        Adw.EntryRow domain_row {
          title: _("_Domain");
          use-underline: true;
          visible: false;
          changed => $on_input_changed();
          entry-activated => $on_entry_activated();
        }

        Adw.SwitchRow hidden_volume_row {
          title: _("_Hidden Volume");
          use-underline: true;
          visible: false;
        }

        Adw.SwitchRow system_volume_row {
          title: _("_Windows System Volume");
          use-underline: true;
          visible: false;
        }

        Adw.EntryRow pim_row {
          title: _("_PIM");
          use-underline: true;
          input-purpose: digits;
          visible: false;
          changed => $on_input_changed();
          entry-activated => $on_entry_activated();
        }

        Adw.PasswordEntryRow password_row {
          title: _("_Password");
          use-underline: true;
          visible: false;
          changed => $on_password_changed();
          entry-activated => $on_entry_activated();
        }
      }

      Adw.PreferencesGroup remember_group {
        visible: false;
        // Keep in sync with remember_choices in the code.
        Adw.ComboRow remember_row {
          title: _("_Remember Password");
          use-underline: true;

          model: StringList {
            strings [
              _("Forget Immediately"),
              _("Until You Log Out"),
              _("Forever"),
            ]
          };
        }
      }
    }

    Revealer spinner_revealer {
      child: Adw.Spinner {
        width-request: 32;
        height-request: 32;
        halign: center;
        margin-top: 6;

        accessibility {
          label: _("Connecting");
        }
      };
    }
  };

  responses [
    cancel: _("_Cancel"),
    connect: _("Co_nnect") suggested,
  ]
}
